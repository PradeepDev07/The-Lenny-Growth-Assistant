# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://lennygrowth.pradeepleadsystems.in

# Database Configuration
# Default is local SQLite (zero-config, no Docker required for development)
# For Postgres with pgvector: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL=sqlite+aiosqlite:///./growth_assistant.db

# Local Ollama Configuration (Host machine default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM Providers (Optional for local demo; required for cloud tiers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Task-Based Model Router Defaults
MODEL_FOR_INTENT=gemini-flash-lite-latest
MODEL_FOR_RETRIEVAL_QA=gemini-3.8-flash
MODEL_FOR_ESSAY=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_FOR_ARTIFACT=gemini-3.8-flash
