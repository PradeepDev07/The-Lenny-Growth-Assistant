# ==============================================================================
# The Lenny Growth Assistant — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Default is local SQLite (zero-config, no Docker required for development)
# For Postgres with pgvector: postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL=sqlite+aiosqlite:///./growth_assistant.db

# Local Ollama Configuration (Host machine default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM Providers (Optional for local demo; required for cloud tiers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# Task-Based Model Router Defaults
MODEL_FOR_INTENT=gemini-2.5-flash-lite
MODEL_FOR_RETRIEVAL_QA=gemini-2.5-flash
MODEL_FOR_ESSAY=anthropic/claude-3.7-sonnet
MODEL_FOR_ARTIFACT=gemini-2.5-flash
