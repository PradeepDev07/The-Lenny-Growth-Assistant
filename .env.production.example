# ==============================================================================
# The Lenny Growth Assistant — Production Environment Example (.env.production.example)
# ==============================================================================

# Application & Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=The Lenny Growth Assistant
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated production domains)
CORS_ORIGINS=https://lennygrowth.pradeepleadsystems.in,https://the-lenny-growth-assistant.vercel.app,http://localhost:3000

# Database Configuration
# SQLite local persistence:
DATABASE_URL=sqlite+aiosqlite:///./growth_assistant.db
# Managed PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@db-host:5432/lenny_assistant

# Local Ollama Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Task-Based Model Router Defaults
MODEL_FOR_INTENT=gemini-flash-lite-latest
MODEL_FOR_RETRIEVAL_QA=gemini-3.8-flash
MODEL_FOR_ESSAY=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_FOR_ARTIFACT=gemini-3.8-flash

# Frontend Production API URL
NEXT_PUBLIC_API_URL=https://lennygrowthapi.pradeepleadsystems.in
